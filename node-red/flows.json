  {
    "id": "aes_decrypt",
    "type": "function",
    "z": "tab_aes",
    "name": "Decrypt AES-256-CBC",
    "func": "// Decrypt iv:ciphertext payload generated by the project AES-256-CBC node.\nconst secret = env.get('AES_KEY');\nif (typeof secret !== 'string' || Buffer.byteLength(secret, 'utf8') !== 32) {\n    node.error('Set AES_KEY to an exactly 32-byte UTF-8 key for AES-256-CBC', msg);\n    return null;\n}\nconst algorithm = 'aes-256-cbc';\nfunction decrypt(text) {\n    const textParts = String(text).split(':');\n    if (textParts.length < 2) throw new Error('Expected iv:ciphertext hex payload');\n    const iv = Buffer.from(textParts.shift(), 'hex');\n    const encryptedText = textParts.join(':');\n    const decipher = crypto.createDecipheriv(algorithm, Buffer.from(secret, 'utf8'), iv);\n    let decrypted = decipher.update(encryptedText, 'hex', 'utf8');\n    decrypted += decipher.final('utf8');\n    return decrypted;\n}\ntry {\n    msg.encrypted_payload = msg.payload;\n    msg.payload = decrypt(msg.payload);\n    return msg;\n} catch (err) {\n    node.error(err.message, msg);\n    return null;\n}",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [
      {
        "var": "crypto",
        "module": "crypto"
      }
    ],
