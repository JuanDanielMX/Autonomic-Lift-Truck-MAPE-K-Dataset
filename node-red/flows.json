  {
    "id": "speed_law",
    "type": "function",
    "z": "tab_opt",
    "name": "Sf = 0.02 + 0.02 B",
    "func": "// Workload-dependent speed law reported in the implementation.\n// Current manuscript notes B was limited to 10 during testing.\nlet B = Number(msg.payload);\nif (!Number.isFinite(B)) return null;\nconst maxB = Number(env.get('MAX_TEST_ORDERS') || 10);\nB = Math.max(0, Math.min(maxB, B));\nmsg.orders = B;\nmsg.payload = 0.02 + 0.02 * B;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
