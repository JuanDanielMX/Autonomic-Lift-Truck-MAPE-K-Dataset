  {
    "id": "aes_encrypt",
    "type": "function",
    "z": "tab_aes",
    "name": "Encrypt AES-256-CBC",
    "func": "// Project AES-256-CBC logic. The project passkey is not distributed in the repository.\n// Set AES_KEY to a 32-byte UTF-8 key before use.\nconst secret = env.get('AES_KEY');\nif (typeof secret !== 'string' || Buffer.byteLength(secret, 'utf8') !== 32) {\n    node.error('Set AES_KEY to an exactly 32-byte UTF-8 key for AES-256-CBC', msg);\n    return null;\n}\nconst algorithm = 'aes-256-cbc';\nconst iv = crypto.randomBytes(16);\nfunction encrypt(text) {\n    const cipher = crypto.createCipheriv(algorithm, Buffer.from(secret, 'utf8'), iv);\n    let encrypted = cipher.update(String(text), 'utf8', 'hex');\n    encrypted += cipher.final('hex');\n    return iv.toString('hex') + ':' + encrypted;\n}\nconst originalData = (typeof msg.payload === 'string') ? msg.payload : JSON.stringify(msg.payload);\nmsg.original_payload = originalData;\nmsg.payload = encrypt(originalData);\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [
      {
        "var": "crypto",
        "module": "crypto"
      }
    ],
    "x": 430,
    "y": 100,
    "wires": [
      [
        "aes_enc_debug",
        "aes_mqtt_out"
      ]
    ]
  },
