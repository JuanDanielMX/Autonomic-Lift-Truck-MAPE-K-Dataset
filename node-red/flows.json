  {
    "id": "battery_pct",
    "type": "function",
    "z": "tab_dash",
    "name": "Voltage to battery %",
    "func": "// Convert battery voltage to dashboard percentage. Set voltage limits for the target battery/sensor calibration.\nconst fullV = Number(env.get('BATTERY_FULL_V') || 12.0);\nconst emptyV = Number(env.get('BATTERY_EMPTY_V') || 0.0);\nconst v = Number(msg.payload);\nif (!Number.isFinite(v) || fullV <= emptyV) return null;\nlet pct = 100 * (v - emptyV) / (fullV - emptyV);\npct = Math.max(0, Math.min(100, pct));\nmsg.payload = Math.round(pct * 100) / 100;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 250,
    "wires": [
      [
        "battery_gauge"
      ]
    ]
  },
